# MySQL
MYSQL_DATABASE=devc
MYSQL_USER=devc
MYSQL_PASSWORD=devc1234
MYSQL_ROOT_PASSWORD=root1234

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Spring datasource
# Docker Compose backend container
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/devc?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
# Local IntelliJ or local bootRun
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/devc?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=devc
SPRING_DATASOURCE_PASSWORD=devc1234

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_ACCESS_COOKIE_NAME=access_token
JWT_ACCESS_COOKIE_SECURE=false
JWT_ACCESS_COOKIE_SAME_SITE=Lax

# App URLs
BACKEND_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Production example
# BACKEND_BASE_URL=http://43.200.4.180.nip.io:8080
# FRONTEND_BASE_URL=http://43.200.4.180.nip.io
# NEXT_PUBLIC_API_BASE_URL=http://43.200.4.180.nip.io:8080

# OpenAI - AI discussion
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_DISCUSSION_SCHEDULER_ENABLED=true

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
